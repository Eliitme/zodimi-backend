# Reverse proxy + automatic TLS for the API (NFR: HTTPS only).
# Caddy over nginx+certbot: certificates renew themselves with no cron entry
# and no renewal failure mode to monitor.
#
# Install on the VPS at /etc/caddy/Caddyfile, then: systemctl reload caddy

{
	servers {
		# Without this Caddy APPENDS the peer address to whatever
		# X-Forwarded-For the client sent, so the header arrives as
		# "<whatever they claimed>, <real ip>". Pinning trusted_proxies makes
		# Caddy replace an untrusted header instead of extending it, which is
		# what lets the API's per-IP rate limit mean anything (see
		# app/core/rate_limit._client_ip). Caddy and the API share this host,
		# so the private ranges cover the only hop that should be trusted.
		trusted_proxies static private_ranges
	}
}

api.app.zodimi.com {
	reverse_proxy 127.0.0.1:8000

	# The RevenueCat webhook authenticates with its own secret, so it must
	# stay reachable — everything else is JWT-guarded by the app itself.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/api.log
		format json
	}
}

# Legal documents must live at a stable public URL before App Store
# submission (Apple blocks review without them) and are linked from the
# paywall and Settings.
app.zodimi.com {
	handle_path /legal/* {
		root * /srv/zodimi-legal
		file_server
	}
	redir / https://apps.apple.com/app/zodimi permanent
}
