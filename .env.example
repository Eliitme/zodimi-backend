# Supabase — local dev values come from `supabase start` output
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# ONLY for legacy projects still signing JWTs with a shared HS256 secret.
# Leave empty otherwise (local CLI stack + new cloud projects sign with
# asymmetric keys — the backend verifies via the JWKS endpoint).
SUPABASE_JWT_SECRET=

# AI provider (Phase 3+). OpenRouter takes precedence when both are set.
# One key reaches Anthropic / OpenAI / Google / open models; swap the model
# without touching code. Leave both empty to run the deterministic fake.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Used only by the background report worker; empty = OPENROUTER_MODEL.
OPENROUTER_REPORT_MODEL=
GEMINI_API_KEY=

# RevenueCat (Phase 7+)
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Browser API test console at /devtools — MUST stay false in production
DEV_TOOLS=false

# Comma-separated browser origins allowed to call the API (web app)
WEB_ORIGINS=http://localhost:3000

# Apple Push Notifications (Phase 8+). The .p8 key file lives on the host and
# is never committed; point APNS_KEY_PATH at it.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.stellune.app
# false for the production APNs gateway; true routes to Apple's sandbox and
# silently drops notifications for App Store builds.
APNS_USE_SANDBOX=true

# Astro Rooms. HMAC key for invite-token hashes — generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Rotating it invalidates every outstanding invitation.
ROOM_INVITE_SECRET=
# Canonical origin of the web app, for invite links (e.g. https://stellune.app).
# Empty: links come back as a path and the client prepends its own origin.
WEB_BASE_URL=
