# Supabase — local dev values come from `supabase start` output
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# ONLY for legacy projects still signing JWTs with a shared HS256 secret.
# Leave empty otherwise (local CLI stack + new cloud projects sign with
# asymmetric keys — the backend verifies via the JWKS endpoint).
SUPABASE_JWT_SECRET=

# AI provider (Phase 3+). OpenRouter takes precedence when both are set.
# One key reaches Anthropic / OpenAI / Google / open models; swap the model
# without touching code. Leave both empty to run the deterministic fake.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=

# RevenueCat (Phase 7+)
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Browser API test console at /devtools — MUST stay false in production
DEV_TOOLS=false

# Comma-separated browser origins allowed to call the API (web app)
WEB_ORIGINS=http://localhost:3000
